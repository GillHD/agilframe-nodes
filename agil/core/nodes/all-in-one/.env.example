# AgilFrame — all-in-one media node configuration.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# Compose reads this file for interpolation and injects it into the container
# through `env_file`. NEVER commit the filled `.env`; it is gitignored. The
# required values are deliberately empty here so a forgotten secret fails at
# startup with an actionable message instead of running with a placeholder.
#
# Ports with host networking are opened on the HOST firewall (see the compose
# header). The agent's health/drain listener is NODE_HTTP_PORT (8080); the
# `AGIL_NODE_HTTP_PORT` alias is accepted when NODE_HTTP_PORT is unset (the
# container healthcheck follows the same precedence).

# --- Core enrollment (REQUIRED the first time) ------------------------------
# Base URL of the Core this node belongs to. The default is the local app; on a
# dedicated node host point it at the Core over HTTPS (bearer credentials).
# Behind 1:1 NAT use the public Core URL, not 127.0.0.1.
# Do NOT embed credentials (https://user:pass@…): fetch() rejects such URLs and
# the agent refuses to start. The node authenticates with headers (one-time
# token, then the stored node key), so the URL is only a base address.
AGIL_CORE_URL=http://127.0.0.1:8787

# One-time enrollment token (`agil_enr_…`) minted in the dashboard
# (Infrastructure → node token) or POST /v1/admin/cluster/tokens. It is burned
# on the first successful registration; keep the `node-state` volume and later
# restarts need only the stored node key. Leave empty when restoring a volume.
AGIL_NODE_TOKEN=

# Pre-issued node key (`nk_…`) for a node registered elsewhere. Optional; the
# agent persists it into the state volume on first start. Prefer the token for
# a fresh node.
AGIL_NODE_KEY=

# Unique id per Core/tenant (1..64 URL-safe chars). A live duplicate is
# rejected with 409; change it per host.
NODE_ID=agil-node-1
NODE_NAME=agil-node-1
# Free-form labels stored in the registry (informational today).
NODE_REGION=
# Informational endpoint the Core records but does not probe yet, e.g.
# https://sfu-1.example.net:7880
NODE_ENDPOINT=
# JSON capacity hint; 0/omitted = not reported (the admin panel can still set
# it, and the agent will not overwrite it with zeros).
# Example: {"maxRooms":10,"maxParticipants":500,"bandwidthMbps":1000}
NODE_CAPACITY=

# --- Feature toggles (REQUIRED) --------------------------------------------
# Comma list of sfu, turn, stun. The role is derived (one feature -> that role,
# several -> all). `turn` already answers STUN, so `turn` does not start a
# second coturn; `stun` alone starts coturn in STUN-only mode (no password and
# no relay range). Unknown tokens/contradicting NODE_ROLE fail fast.
NODE_FEATURES=sfu,turn,stun
# Optional override; must match the derived role or be `all`.
# NODE_ROLE=all
# Set to false to skip all bundled media processes. An explicitly configured
# SFU_EXTERNAL_URL is still monitored. The advertised features are unchanged.
NODE_MEDIA_ENABLED=true

# --- Public address / LAN trial --------------------------------------------
# Public IPv4 advertised in ICE/TURN candidates. Empty = auto-detect from the
# host NIC. Behind 1:1 cloud NAT the NIC is private: set the public IP here (or
# TURN_EXTERNAL_IP/SFU_NODE_IP) or media will never flow.
NODE_PUBLIC_IP=
# Accept a private/loopback advertised address for a LAN/dev trial only.
# 0 in production: a remote participant would receive an unroutable candidate.
TURN_ALLOW_PRIVATE_IP=0

# --- SFU / LiveKit (required when NODE_FEATURES contains sfu) ---------------
# Must be the same pair the Core uses as AGIL_SFU_API_KEY/AGIL_SFU_API_SECRET.
# The secret is at least 32 chars; LiveKit validates join tokens with it.
LIVEKIT_API_KEY=agil_sfu
LIVEKIT_API_SECRET=
# Optional private HTTP or HTTPS origin of a separate LiveKit service.
# If set, the agent probes this service and leaves its process lifecycle to its operator.
SFU_EXTERNAL_URL=

# Defaults match agil/core/deploy/livekit/livekit.yaml.
SFU_PORT=7880
SFU_TCP_PORT=7881
SFU_UDP_MIN_PORT=50000
SFU_UDP_MAX_PORT=50100
# Optional single-port UDP mux (0 = off). Replaces the UDP range in the
# rendered LiveKit config; open only this port instead of SFU_UDP_MIN/MAX.
SFU_UDP_MUX_PORT=0
# LiveKit Prometheus endpoint. Binds all interfaces (LiveKit has no bind-address
# setting) and host networking exposes it: firewall 6789 or set 0 to disable.
SFU_METRICS_PORT=6789
# Explicit advertised IP (wins over NODE_PUBLIC_IP); disables STUN discovery.
SFU_NODE_IP=
# true (default when no SFU_NODE_IP is set): let LiveKit discover the public IP
# with STUN. Set false when STUN is blocked and SFU_NODE_IP is set.
# SFU_USE_EXTERNAL_IP=true
# Optional Redis for multi-node LiveKit routing; the standalone node does not
# need it. Accepts redis://, rediss:// or host:port.
SFU_REDIS_URL=
# RTMP publishing base URL for the optional compose.local-ingress.yml. Set a
# reachable address if the publisher is outside this host. Leave credentials out.
# SFU_RTMP_INGRESS_BASE_URL=rtmp://127.0.0.1:1935/live
# Set true with an explicit NODE_ID to allow dashboard start, stop and restart.
AGIL_NODE_INGRESS_LIFECYCLE=false
SFU_LOG_LEVEL=info

# Optional image pins for the official Compose overrides. Use exactly the 64
# lowercase hexadecimal characters after sha256: in the approved manifest digest.
# Leave unset to keep the tag specified by the matching Compose override.
# AGIL_REDIS_IMAGE_DIGEST=
# AGIL_EGRESS_IMAGE_DIGEST=
# AGIL_SIP_IMAGE_DIGEST=
# AGIL_INGRESS_IMAGE_DIGEST=
# AGIL_EDGE_IMAGE_DIGEST=
# AGIL_NODE_EXPORTER_IMAGE_DIGEST=

# --- TURN / STUN (coturn) ---------------------------------------------------
# Set one of TURN_PASSWORD (static) or TURN_STATIC_AUTH_SECRET (temporary
# credentials) when NODE_FEATURES contains turn. Generate it with e.g.
# `openssl rand -hex 24`; must not contain spaces, `#` or `:` (coturn config
# syntax). It is written to a 0600 file in the container, never logged.
TURN_PASSWORD=
TURN_STATIC_AUTH_SECRET=
TURN_PORT=3478
TURN_MIN_PORT=49200
TURN_MAX_PORT=49250
TURN_REALM=agil.local
TURN_USER=agil
# Optional explicit relay address; defaults to NODE_PUBLIC_IP / auto-detect.
TURN_EXTERNAL_IP=
# Private NIC address for 1:1 NAT (`external-ip=PUBLIC/PRIVATE` in coturn).
TURN_INTERNAL_IP=
# Bind one interface (optional; empty = all).
TURN_LISTEN_IP=
TURN_TOTAL_QUOTA=100
TURN_USER_QUOTA=0
# TURN/TLS on 5349 requires a mounted certificate/key pair (see README).
TURN_TLS=0
TURN_TLS_PORT=5349
# Optional public DNS name covered by the certificate SAN and reported to Core.
TURN_TLS_HOSTNAME=
# Opt in after provisioning this node in Core's AGIL_COTURN_AUTO_SECRETS.
TURN_AUTO_REGISTER=0
# Host directory mounted at /certs by the commented compose volume.
TURN_CERT_HOST_DIR=/etc/letsencrypt/live/turn.example.com
TURN_CERT=/certs/fullchain.pem
TURN_PKEY=/certs/privkey.pem
# Extra comma-separated args appended to the rendered command (advanced).
# NODE_LIVEKIT_ARGS=
# NODE_TURN_ARGS=

# --- Agent / health / heartbeat --------------------------------------------
# 5..3600. Core marks a node offline after 90 s of silence.
NODE_HEARTBEAT_SEC=30
# 0 = no key expiry. When >0, the key must be rotated before it expires.
NODE_KEY_TTL_SEC=0
# Rotate this many seconds before expiry; requires AGIL_API_KEY. 0 disables the
# automatic rotation (the key still expires in Core).
NODE_KEY_ROTATE_BEFORE_SEC=0
# Admin key allowed to POST /v1/admin/nodes/:id/rotate-key. Needed only for
# automatic/endpoint rotation; it grants admin scope, so keep it scoped.
AGIL_API_KEY=
# Protects POST /v1/control/drain and /v1/control/rotate-key. When empty those
# endpoints accept loopback only (docker exec). Set >=8 chars to call remotely.
NODE_CONTROL_TOKEN=
# Health/metrics/drain listener port (default 8080; the image sets no ENV, so
# this value or the AGIL_NODE_HTTP_PORT alias decides). NODE_HTTP_PORT wins when
# both are set; the container healthcheck resolves them in the same order.
NODE_HTTP_PORT=8080
# Bind address for the health/metrics listener (0.0.0.0 inside the container).
NODE_HTTP_HOST=0.0.0.0
# Informational path recorded on the node (Core does not probe it yet).
NODE_HEALTH_PATH=/healthz
NODE_LOG_LEVEL=info
# Register + one heartbeat, then exit (CI/smoke; no media, no HTTP server).
NODE_ONCE=false

# --- Docker add-on modules (optional) --------------------------------------
# auto = probe the Docker Engine socket and degrade to an agent-only node when
# it is absent; on = same but warns loudly if missing; off = no Docker access.
# Module ids/actions/images are owned by the Core catalog
# (agil/core/apps/server/src/node-modules.ts); the dashboard never supplies an
# image. Requires the Docker socket mounted into the container (see README).
NODE_MODULES=auto
# Docker Engine endpoint for module containers (falls back to DOCKER_HOST).
# unix:// socket, npipe:// named pipe or tcp://host:port (dev/test only; no TLS).
NODE_DOCKER_HOST=unix:///var/run/docker.sock
# Optional node-local module env values ({ "<module>": { "KEY": "value" } }).
# Values are passed to Docker and never logged, reported or sent to the Core.
# NODE_MODULE_ENV_FILE=/var/lib/agil-node/module-env.json
# Optional catalog of operator-approved custom images by digest.
# NODE_MODULE_TEMPLATES_FILE=/var/lib/agil-node/module-templates.json

# State/runtime paths default to the image values; if you override the state
# dir, change the compose volume target to match. The runtime dir must be
# writable (tmpfs in compose).
NODE_STATE_DIR=/var/lib/agil-node
NODE_RUNTIME_DIR=/run/agil
# Media binaries (defaults come from the image; PATH lookup).
NODE_LIVEKIT_BIN=livekit-server
NODE_TURN_BIN=turnserver

# --- Image build ------------------------------------------------------------
# Keep in sync with agil/core/deploy/livekit/docker-compose.yml.
LIVEKIT_VERSION=v1.13.11
# Tag for the locally built image.
AGIL_NODE_IMAGE=agil-node-all-in-one:0.1.0
